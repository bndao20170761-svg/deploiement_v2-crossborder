# ============================================================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT - DEPLOIEMENT GCP
# ============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement
# IMPORTANT: Ne commitez JAMAIS le fichier .env dans Git!
# ============================================================================

# ============================================================================
# DATABASE PASSWORDS
# ============================================================================
MONGO_PASSWORD=admin123
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER_PASSWORD=user123
MYSQL_REFERENCE_PASSWORD=reference123
MYSQL_PATIENT_PASSWORD=patient123

# ============================================================================
# JWT SECRET (IMPORTANT: Changez cette valeur en production!)
# ============================================================================
# Générez un secret fort avec: openssl rand -base64 64
JWT_SECRET=VotreSecretJWTTresSecurise123456789AbCdEfGhIjKlMnOpQrStUvWxYz

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Remplacez 13.53.134.15 par votre IP GCP
CORS_ALLOWED_ORIGINS=http://13.53.134.15:3001,http://13.53.134.15:3002,http://13.53.134.15:3003,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# Remplacez 13.53.134.15 par votre IP GCP
REACT_APP_GATEWAY_URL=http://13.53.134.15:8080
REACT_APP_API_URL=http://13.53.134.15:8080
REACT_APP_USER_API_URL=http://13.53.134.15:8080
REACT_APP_FORUM_API_URL=http://13.53.134.15:8080
REACT_APP_AUTH_API_URL=http://13.53.134.15:8080/api/auth
REACT_APP_FORUM_URL=http://13.53.134.15:3001
REACT_APP_FRONTEND1_URL=http://13.53.134.15:3002
REACT_APP_FRONTEND2_URL=http://13.53.134.15:3003

# ============================================================================
# SPRING PROFILE
# ============================================================================
# Utilisez 'prod' pour production, 'dev' pour développement
SPRING_PROFILES_ACTIVE=prod
